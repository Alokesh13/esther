        </button>
        <button onclick="event.stopPropagation(); navigateLightbox(1)" class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors p-2 z-10">
            <i data-lucide="chevron-right" class="w-10 h-10"></i>
