    <!-- Floating hearts containers -->
    <div class="floating-heart-container invisible fixed top-1/4 left-[15%] z-40 pointer-events-none">
        <div class="floating-heart text-rose-400 text-2xl" style="animation-delay: 0s;">♥</div>
