                        <img src="https://z-cdn-media.chatglm.cn/files/8281f46c-6298-4e34-a9a5-80e72eb0656a.png?auth_key=1883432752-1774bba955f04d80b486090c79d0137f-0-b9ef26f30d26b5c5eadb835693d07c47" alt="Esther" class="w-full h-full object-cover" loading="lazy">
