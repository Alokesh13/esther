            <i data-lucide="x" class="w-8 h-8"></i>
        </button>
        <button onclick="event.stopPropagation(); navigateLightbox(-1)" class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors p-2 z-10">
